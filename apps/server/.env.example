APP_NAME=Switchboard
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

API_TOKEN=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CONFIG_PATH=configs/config.yaml

# --- Security & policy (see docs/security.md) -------------------------------
# When true (with API_TOKEN set), /dashboard/* and /v1/cache/stats also
# require auth. Browsers can authenticate via HTTP Basic (password = API_TOKEN).
DASHBOARD_AUTH=false

# Hard cap on the day's recorded USD spend. 0 disables.
# When today's `request_log.estimated_usd` sum >= this, /v1/chat/{completions,
# compare} returns 503 until 00:00 UTC.
MAX_DAILY_USD=0

# When false, requests carrying a `model:` field are rejected with 400.
# Set true to keep the legacy behaviour (route them through the mock provider).
ALLOW_CLIENT_MODEL_OVERRIDE=false
